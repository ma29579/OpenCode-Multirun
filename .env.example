# Copy to .env to override the defaults used by docker-compose.yml and study/setup-ollama.sh.

# Embedding model of the docs MCP server (used for semantic search in the guidelines)
EMBEDDING_MODEL=nomic-embed-text:latest

# Port of the local Ollama (default 11434)
OLLAMA_PORT=11434

# Host ports of the three docs MCP servers (container port 6280): all guidelines / general guidelines only /
# project-specific rules only.
# If you change them, run study/build-scenarios.py again (it writes the ports into the scenarios).
DOCS_MCP_PORT=6281
DOCS_MCP_STATIC_PORT=6282
DOCS_MCP_SWAPPED_PORT=6283
