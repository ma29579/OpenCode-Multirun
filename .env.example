# Copy to .env to override the defaults used by docker-compose.yml.

# Coding model (used by OpenCode as "ollama/<name>")
CODING_MODEL=qwen2.5-coder:7b

# Embedding model (used by docs-mcp-server for text analysis / semantic search)
EMBEDDING_MODEL=nomic-embed-text:latest

# Context window of Ollama models (tokens); 16k-32k recommended for tool calls
OLLAMA_CONTEXT_LENGTH=32768
